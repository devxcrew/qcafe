APP_NAME=QCafe
APP_PORT=5176
APP_URL=http://127.0.0.1:5176
APP_MODE=development
APP_HOST=127.0.0.1
DB_SQLITE_PATH=storage/qcafe.sqlite
MCP_SERVER_URL=https://mcp.codexsun.com/mcp
MCP_SERVER_SECRET=
APP_ID=qcafe
APP_USER=developer

# Database identity
IDENTITY_MODE=single-client
IDENTITY_TENANT_ID=default
IDENTITY_TENANT_NAME=QCafe organization
IDENTITY_SESSION_SECONDS=28800

# Optional bootstrap accounts. Set strong passwords in ignored .env only.
IDENTITY_SEED_USER_EMAIL=
IDENTITY_SEED_USER_NAME=
IDENTITY_SEED_USER_PASSWORD=
IDENTITY_SEED_ADMIN_EMAIL=
IDENTITY_SEED_ADMIN_NAME=
IDENTITY_SEED_ADMIN_PASSWORD=
IDENTITY_SEED_SUPER_ADMIN_EMAIL=
IDENTITY_SEED_SUPER_ADMIN_NAME=
IDENTITY_SEED_SUPER_ADMIN_PASSWORD=

# Identity lifecycle delivery. Required for invitation and recovery acceptance.
EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
