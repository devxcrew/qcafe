{
  "app": {
    "mode": "single-server",
    "apiConfig": "tsconfig.server.json",
    "webConfig": "tsconfig.json",
    "apiEntry": "src/api/index.ts",
    "envFile": ".env"
  },
  "boundaries": {
    "sources": ["src"],
    "frontendSources": ["src/web"],
    "compilerPackage": "typescript-eslint-compiler",
    "developmentPackages": ["vite"]
  },
  "maintenance": {
    "changelogPath": "agent/CHANGELOG.md"
  }
}
